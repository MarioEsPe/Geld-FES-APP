---
import '../styles/global.css';

const { title = "GELD FES" } = Astro.props;

// 1. Leemos la variable de entorno de forma segura en el servidor de Astro
const googleClientId = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>{title}</title>

    <!-- Conexión al manifiesto PWA -->
    <link rel="manifest" href="/manifest.json" />

    <!-- Color de la barra de estado del celular (Emerald 500) -->
    <meta name="theme-color" content="#10b981" />

    <!-- Soporte PWA moderno y clásico para iOS/Android -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
  </head>
  <body class="bg-slate-200 text-slate-900 font-sans antialiased min-h-screen flex justify-center m-0 p-0">
    
    <div class="w-full max-w-md md:max-w-5xl bg-slate-50 min-h-screen shadow-2xl relative flex flex-col overflow-hidden">
      <!-- 2. Inyectamos la variable al navegador limpiamente con define:vars -->
      <script define:vars={{ googleClientId }}>
        window.env = {
          GOOGLE_CLIENT_ID: googleClientId
        };
      </script>
      <slot />
    </div>

  </body>
</html>